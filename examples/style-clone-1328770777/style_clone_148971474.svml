<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="styleboard" from="@example/style-board@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="./style_clone_148971474.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="edit" clock={clock} end="20s"/>
  <spatial:Canvas id="canvas" width="720" height="1280"/>

  <styleboard:Board id="style-clone-148" timeline={edit.timeline} canvas={canvas}
    during="program"
    title="148971474｜20–40秒风格小样"
    subtitle="送礼钩子、白花香关键词、露脸/产品穿插、差异化四角标签"
    open="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/open.jpg"
    product="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/product.jpg"
    face="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/face.jpg"
    circle="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/circle.jpg"
    notes="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/notes.jpg"
    final="C:/Users/admin/Documents/视频制作/hypit-local-demo/examples/style-clone-1328770777/assets148971474/final.jpg"/>

  <film:Film id="main" canvas={canvas} timeline={edit.timeline} appearance={look.film.main}>
    <film:Track source={style-clone-148.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={edit.timeline}/>
</svml>
